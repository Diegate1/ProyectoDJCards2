# .env.render - Environment configuration for Render.com deployment
# Copy this file to create .env.production or use these values in Render dashboard env vars

# ========== APPLICATION ==========
NODE_ENV=production
PORT=10000  # Render assigns dynamic port, but use 10000 as default

# ========== DATABASE ==========
# Get this from Render PostgreSQL dashboard after creating database
# Format: postgresql://user:password@subdomain.render.com:5432/database_name
DATABASE_URL=postgresql://postgres:REPLACE_WITH_SECURE_PASSWORD@dpg-XXXXX.render.com:5432/pokemontcg

# ========== FRONTEND ==========
FRONTEND_URL=https://pokemontcg-frontend.onrender.com

# ========== API CONFIGURATION ==========
API_BASE_URL=https://pokemontcg-backend.onrender.com
API_PORT=10000

# ========== CORS ==========
CORS_ORIGIN=https://pokemontcg-frontend.onrender.com
CORS_CREDENTIALS=true

# ========== LOGGING ==========
LOG_LEVEL=info
LOG_FORMAT=json
SYNC_VERBOSE=false

# ========== EXTERNAL APIS ==========
POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2
TCGDEX_API_URL=https://api.tcgdex.net/v1
TCGTRACKING_API_URL=https://tcgtracking.com/tcgapi/v1
POKEMON_TCG_API_KEY=  # Leave empty if not required, fill if you have API key

# ========== SYNC CONFIGURATION ==========
SYNC_BATCH_SIZE=100         # Cards per batch
SYNC_RETRY_ATTEMPTS=3       # Retry on failure
SYNC_RETRY_DELAY_MS=1000    # Delay between retries
SYNC_TIMEOUT_MS=30000       # Request timeout

# ========== REDIS (if using caching) ==========
# REDIS_URL=redis://default:password@redis-hostname:port

# ========== OPTIONAL: ADMIN CREDENTIALS ==========
# For basic auth on admin endpoints (optional)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ========== DOCKER SPECIFIC ==========
DOCKER_ENVIRONMENT=true
