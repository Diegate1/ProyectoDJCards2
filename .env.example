# ========================================
# Backend Configuration
# ========================================

PORT=3000
NODE_ENV=development
DOCKER_ENVIRONMENT=false

# ========================================
# Database Configuration
# ========================================

# Development (docker-compose)
POSTGRES_DB=pokemontcg
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=pokemon
DB_PORT=5432

# Production (Render) - Set in Dashboard
# DATABASE_URL=postgresql://user:password@host:5432/database

DATABASE_URL=postgresql://pokemon:pokemon@localhost:5432/pokemontcg

# ========================================
# Frontend URLs
# ========================================

FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# ========================================
# External APIs
# ========================================

POKEMON_TCG_API_KEY=
POKEMON_TCG_BASE_URL=https://api.pokemontcg.io/v2

TCGDEX_BASE_URL=https://api.tcgdex.net/v2
TCGDEX_DEFAULT_LANG=en

TCGCSV_BASE_URL=https://tcgcsv.com/tcgplayer
POKEMON_CATEGORY_ID=3

# ========================================
# Logging
# ========================================

LOG_LEVEL=info
SYNC_VERBOSE=false
